<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses langsung ke file sensitif (.env, .git, dll)
    <FilesMatch "^\.(env|git)">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Arahkan semua request ke dalam folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
